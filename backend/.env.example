# Local development settings. In Render, configure these in the service dashboard.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
APP_VERSION=1.0.0
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174

# Required for address autocomplete and route alternatives.
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_PROFILE=driving-hgv

# Public Nominatim search endpoint; do not use it for autocomplete.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
